# Copie para .env e preencha. Variáveis EXPO_PUBLIC_* são embutidas no bundle (públicas).
EXPO_PUBLIC_SUPABASE_URL=https://api.avancekids.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Preço, período de teste e URLs de retorno do checkout ficam no servidor
# (supabase secrets: STRIPE_PRICE_MONTHLY, STRIPE_TRIAL_DAYS,
# CHECKOUT_SUCCESS_URL, CHECKOUT_CANCEL_URL). O app lê o que está vigente pela
# function `billing-config` e não envia plano nenhum — só existe o mensal.
